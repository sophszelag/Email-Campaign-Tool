# Copy this file to .env.local for local development, and set the same
# values in Vercel's Project Settings → Environment Variables for
# deployed environments. Never commit the real values.

# --- Supabase (Brendan provisions the project) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (Brendan verifies the mail.sidelineswap.com sending domain) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Optional override; defaults to "SidelineSwap Events <events@mail.sidelineswap.com>"
CAMPAIGN_FROM_ADDRESS=

# --- Google SSO (Brendan creates OAuth credentials in Workspace admin) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Local dev: http://localhost:3000  |  Deployed: your Vercel URL
NEXTAUTH_URL=http://localhost:3000
